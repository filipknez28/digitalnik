<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Digitalnik Urejevalnik</title>
<hta:application applicationname="DigitalnikUrejevalnik" singleinstance="yes" scroll="yes" windowstate="normal"/>
<style>
body{margin:0;background:#e1dfdd;font-family:'Segoe UI',Arial,sans-serif;font-size:13px;color:#333}
/* Word-like ribbon */
#tabs{background:#2b579a;padding:0 6px}
#tabs span{display:inline-block;padding:7px 14px;color:#cfe0f5;cursor:pointer;font-size:12px}
#tabs span.on{background:#f3f2f1;color:#2b579a;font-weight:600;border-radius:3px 3px 0 0}
.ribbon{background:#f3f2f1;border-bottom:1px solid #d1cfcb;padding:8px 10px 4px}
#rib-nast{display:none}
.rg{display:inline-block;vertical-align:top;padding:0 12px;border-right:1px solid #d1cfcb;margin-right:6px;text-align:center}
.rg .lbl{display:block;font-size:10px;color:#8a8886;margin-top:2px}
.rb{display:inline-block;vertical-align:top;width:62px;padding:5px 2px;cursor:pointer;text-align:center;border-radius:3px;border:1px solid transparent;background:transparent}
.rb:hover{background:#e1dfdd;border-color:#c8c6c4}
.rb .g{display:block;font-size:18px;line-height:1.1}
.rb .t{display:block;font-size:11px;margin-top:2px}
.rb.acid{background:#c9ff2e;border-color:#a8d400}
.rb.acid:hover{background:#b8f000}
.rb.mag{color:#a8008c}
/* navigation pane */
#nav{float:left;width:255px;background:#faf9f8;border-right:1px solid #d1cfcb;height:640px;overflow:auto}
#nav .hd{padding:8px 12px 4px;font-size:11px;color:#8a8886;text-transform:uppercase;letter-spacing:1px}
#f-iskaj{width:88%;margin:0 12px 10px;border:1px solid #c8c6c4;border-radius:2px;padding:6px 8px;font-size:12px;background:#fff}
.item{padding:8px 12px;border-bottom:1px solid #edebe9;cursor:pointer;font-size:12.5px}
.item:hover{background:#efeef7}
.item.sel{background:#dce6f5;border-left:3px solid #2b579a;padding-left:9px}
.item small{color:#8a8886;font-size:10px;display:block}
#btn-nova-sm{margin:10px 12px;border:1px solid #c8c6c4;background:#fff;border-radius:2px;padding:6px 10px;cursor:pointer;font-size:12px}
#btn-nova-sm:hover{border-color:#2b579a;color:#2b579a}
/* document area */
#docwrap{margin-left:255px;padding:26px 30px 70px}
.page{background:#fff;max-width:840px;margin:0 auto;box-shadow:0 1px 6px rgba(0,0,0,.3);padding:44px 64px 60px;min-height:640px}
.f{border:0;outline:none;width:100%;background:transparent;font-family:'Segoe UI',Arial,sans-serif;color:#222}
#f-naslov{font-size:30px;font-weight:700;line-height:1.15;padding:2px 0 8px;border-bottom:2px solid #c9ff2e}
#f-povz{font-size:16px;color:#666;line-height:1.5;padding:12px 0 6px}
#f-bes{font-size:13.5px;line-height:1.65;min-height:340px;resize:vertical}
#f-meta{font-size:12px;color:#888;padding:6px 0 0;border-top:1px solid #edebe9;margin-top:10px}
.metarow{font-size:12px;color:#8a8886;margin-bottom:6px}
select#f-kat{border:1px solid #c8c6c4;border-radius:2px;padding:4px 6px;font-size:12px;background:#fff;color:#333}
#f-avt{border:1px solid #c8c6c4;border-radius:2px;padding:4px 6px;font-size:12px;width:180px;color:#333}
/* status bar */
#status{position:fixed;left:0;right:0;bottom:0;background:#2b579a;color:#fff;font-size:12px;padding:5px 14px}
#status .r{float:right;color:#cfe0f5}
.card{background:#fff;border:1px solid #d1cfcb;border-radius:4px;padding:16px 20px;max-width:840px;margin:0 auto 14px;box-shadow:0 1px 4px rgba(0,0,0,.15)}
.card h3{margin:0 0 8px;font-size:14px;color:#2b579a}
.card p,.card li{font-size:12.5px;line-height:1.6;color:#444}
.card ol{margin:4px 0 10px 18px;padding:0}
.row2 input{border:1px solid #c8c6c4;border-radius:2px;padding:7px 9px;font-size:12px;width:420px}
.row2 .rb{width:auto;padding:6px 14px;margin-left:6px}
</style>
</head>
<body>

<div id="tabs">
  <span id="tab-dom" class="on" onclick="showTab('dom')">Domov</span>
  <span id="tab-nast" onclick="showTab('nast')">Nastavitve</span>
</div>

<div id="rib-dom" class="ribbon">
  <div class="rg">
    <span class="rb acid" id="btn-shrani"><span class="g">&#10004;</span><span class="t">Shrani novico</span></span>
    <span class="rb" id="btn-nova"><span class="g">&#10133;</span><span class="t">Nova novica</span></span>
    <span class="rb" id="btn-brisi"><span class="g">&#10006;</span><span class="t">Izbri&#353;i</span></span>
    <span class="lbl">Novice</span>
  </div>
  <div class="rg">
    <span class="rb" id="btn-dup"><span class="g">&#10079;</span><span class="t">Podvoji</span></span>
    <span class="rb" id="btn-gor"><span class="g">&#9650;</span><span class="t">Gor</span></span>
    <span class="rb" id="btn-dol"><span class="g">&#9660;</span><span class="t">Dol</span></span>
    <span class="lbl">Urejanje</span>
  </div>
  <div class="rg">
    <span class="rb" id="btn-prenesi"><span class="g">&#8681;</span><span class="t">Prenesi stran</span></span>
    <span class="rb mag" id="btn-objavi"><span class="g">&#10148;</span><span class="t">Objavi na GitHub</span></span>
    <span class="lbl">Objava</span>
  </div>
</div>

<div id="rib-nast" class="ribbon">
  <div class="rg" style="text-align:left;border:0">
    <b>GitHub &#382;eton za objavo:</b>
    <div class="row2" style="margin-top:6px"><input id="f-token" placeholder="github_pat_..."><span class="rb" id="btn-token" style="border:1px solid #c8c6c4;background:#fff"><span class="t">Shrani &#382;eton</span></span></div>
    <span class="lbl" style="text-align:left">github.com/settings/tokens &rarr; Fine-grained &rarr; repo digitalnik &rarr; Contents: Read and write</span>
  </div>
</div>

<div id="nav">
  <div class="hd">Navigacija: novice</div>
  <input id="f-iskaj" placeholder="i&#353;&#269;i ...">
  <div id="list"></div>
  <button id="btn-nova-sm">+ Nova novica</button>
</div>

<div id="docwrap">
  <div class="page">
    <input id="f-naslov" class="f" placeholder="Naslov novice ...">
    <div class="metarow">Kategorija: <select id="f-kat"><option>AI</option><option>Telefoni</option><option>Igre</option><option>Internet</option><option>Startupi</option></select> &nbsp; Avtor: <input id="f-avt" value="Filip Knez"></div>
    <textarea id="f-povz" class="f" placeholder="Povzetek: en ali dva stavka, ki gre pod naslov ..."></textarea>
    <textarea id="f-bes" class="f" placeholder="Besedilo novice ... pi&#353;i prosto, kot v Wordu."></textarea>
    <input id="f-meta" class="f" readonly>
  </div>
</div>

<div id="status"><span id="s-msg">Pripravljeno. Najprej klikni Prenesi stran.</span><span class="r" id="s-counts"></span></div>

<script language="JScript">
var FSO=new ActiveXObject("Scripting.FileSystemObject");
var API="https://api.github.com/repos/filipknez28/digitalnik/contents/index.html";
var RAW="https://raw.githubusercontent.com/filipknez28/digitalnik/main/index.html";
var CATCLS={"AI":"c-ai","Telefoni":"c-fon","Igre":"c-igra","Internet":"c-net","Startupi":"c-ai"};
var html="", data=[], cur=-1;
function myDir(){ var p=unescape(location.pathname).replace(/^\//,""); return p.substring(0,p.lastIndexOf("/")+1); }
var IDX=myDir()+"index.html", TOKF=myDir()+"token.txt", DRAFTF=myDir()+"osnutek.txt";
function $(id){return document.getElementById(id);}
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
function say(t){$("s-msg").innerHTML=esc(t);}
function readText(path){ var st=new ActiveXObject("ADODB.Stream"); st.Type=2; st.Charset="utf-8"; st.Open(); st.LoadFromFile(path); var t=st.ReadText(); st.Close(); return t; }
function writeText(path,t){ var st=new ActiveXObject("ADODB.Stream"); st.Type=2; st.Charset="utf-8"; st.Open(); st.WriteText(t); st.SaveToFile(path,2); st.Close(); }
function utf8B64(s){ var st=new ActiveXObject("ADODB.Stream"); st.Type=2; st.Charset="utf-8"; st.Open(); st.WriteText(s); st.Position=0; st.Type=1; var bin=st.Read(); st.Close(); var xml=new ActiveXObject("MSXML2.DOMDocument.6.0"); var n=xml.createElement("b64"); n.dataType="bin.base64"; n.nodeTypedValue=bin; return n.text; }
function fmtKdaj(d){ function p2(n){return (n<10?"0":"")+n;} var now=new Date(); var base=p2(d.getDate())+". "+p2(d.getMonth()+1)+".";
  if(d.toDateString()==now.toDateString()) return "danes ob "+p2(d.getHours())+":"+p2(d.getMinutes());
  return base+" "+d.getFullYear()+" ob "+p2(d.getHours())+":"+p2(d.getMinutes()); }
function minB(t){ var n=t.replace(/^\s+|\s+$/g,"").split(/\s+/).length; return Math.max(1,Math.round(n/200))+" min branja"; }
function parseData(){ var a=html.indexOf('id="novice-data">'), b=-1; if(a>=0){ b=html.indexOf('<'+'/scr'+'ipt>',a); }
  if(a<0||b<0){ data=[]; return; } var j=html.substring(a+17,b); try{ data=JSON.parse(j); }catch(e){ data=[]; } }
function splice(s,a,b,rep){ var i=s.indexOf(a), j=s.indexOf(b); if(i<0||j<0||j<i) return s; return s.substring(0,i+a.length)+"\n"+rep+"\n"+s.substring(j); }
function renderBlock(){
  var s='<scr'+'ipt type="application/json" id="novice-data">'+JSON.stringify(data).replace(/<\//g,"<\\/")+'<'+'/scr'+'ipt>\n';
  if(data.length==0){
    s+='<section class="hero"><article><div class="kicker">Digitalnik</div><h1 class="big">Kmalu prva novica</h1><p class="dek">Stran je pripravljena in čaka na tvojo prvo novico. Piši jo v urejevalniku DigitalnikUrejevalnik.hta in objavi z gumbom Objavi na GitHub.</p><p class="meta">Urejevalnik: <b>DigitalnikUrejevalnik.hta</b></p></article><div class="side"></div></section>';
    s+='\n<div class="sect" style="display:none"><h2>Najnovejše</h2></div>\n<section class="grid"></section>';
    return s;
  }
  var h=data[0];
  s+='<section class="hero"><article><div class="kicker">Zadnja novica · '+esc(h.kat)+'</div><h1 class="big"><a href="#">'+esc(h.naslov)+'</a></h1><p class="dek">'+esc(h.povz)+'</p><p class="meta">Avtor: <b>'+esc(h.avt)+'</b> · '+esc(h.kdaj)+' · '+minB(h.bes)+'</p></article><div class="side">';
  for(var i=1;i<data.length&&i<4;i++){var a=data[i];
    s+='<article><span class="chip '+CATCLS[a.kat]+'">'+esc(a.kat)+'</span><h3><a href="#">'+esc(a.naslov)+'</a></h3><p class="meta">'+esc(a.kdaj)+'</p></article>';}
  s+='</div></section>';
  if(data.length>1){
    s+='\n<div class="sect"><h2>Najnovejše</h2></div>\n<section class="grid">';
    for(var j=1;j<data.length;j++){var b=data[j];
      s+='<article class="card"><span class="chip '+CATCLS[b.kat]+'">'+esc(b.kat)+'</span><h3>'+esc(b.naslov)+'</h3><p>'+esc(b.povz)+'</p><p class="meta">'+esc(b.kdaj)+'</p></article>';}
    s+='</section>';
  }
  return s;
}
function tickerHTML(){ var t="";
  if(data.length==0){ t="<b>DIGITALNIK</b> Prva novica prihaja kmalu."; }
  else{ for(var i=0;i<data.length;i++){ t+="<b>"+String(data[i].kat).toUpperCase()+"</b> "+esc(data[i].naslov)+" "; } }
  return "<span>"+t+"</span>"; }
function rebuild(){ html=splice(html,"<!--NOVICE:START-->","<!--NOVICE:END-->",renderBlock()); html=splice(html,"<!--TICKER:START-->","<!--TICKER:END-->",tickerHTML()); }
function saveLocal(){ rebuild(); writeText(IDX,html); say("Shranjeno lokalno ob "+fmtKdaj(new Date()).substring(10)+". Za objavo klikni Objavi na GitHub."); }
function loadLocal(){ if(!FSO.FileExists(IDX)){ say("V tej mapi ni index.html. Klikni Prenesi stran (v traku zgoraj)."); renderList(""); loadDraft(); return; }
  html=readText(IDX); parseData(); renderList(""); loadDraft();
  say("Naloženo: "+data.length+" novic."+(data.length==0?" Napiši prvo novico in Objavi.":"")); }
function downloadSite(){ var x=new ActiveXObject("MSXML2.ServerXMLHTTP.6.0"); x.open("GET",RAW,false); x.send();
  if(x.status==200){ html=x.responseText; writeText(IDX,html); parseData(); renderList(""); say("Preneseno s spleta: "+data.length+" novic."); }
  else say("Prenos ni uspel (koda "+x.status+"). Preveri internet."); }
function renderList(q){
  var el=$("list"); el.innerHTML=""; q=(q||"").toLowerCase();
  var shown=0;
  for(var i=0;i<data.length;i++){
    if(q && String(data[i].naslov+" "+data[i].kat).toLowerCase().indexOf(q)<0) continue;
    shown++;
    var d=document.createElement("div");
    d.className="item"+(i==cur?" sel":"");
    d.innerHTML="<small>"+esc(data[i].kat)+" · "+esc(data[i].kdaj)+"</small>"+esc(data[i].naslov);
    d.onclick=(function(k){return function(){openItem(k);};})(i);
    el.appendChild(d);
  }
  if(shown==0) el.innerHTML='<div class="item"><small>'+(q?"ni zadetkov":"seznam je prazen")+'</small></div>';
}
function clearForm(){ $("f-naslov").value=""; $("f-povz").value=""; $("f-bes").value=""; $("f-kat").value="AI"; updateCounts(); }
function openItem(i){ cur=i; var a=data[i];
  $("f-naslov").value=a.naslov; $("f-kat").value=a.kat; $("f-povz").value=a.povz; $("f-bes").value=a.bes; $("f-avt").value=a.avt;
  renderList($("f-iskaj").value); updateCounts(); }
function saveItem(){
  var nas=$("f-naslov").value.replace(/^\s+|\s+$/g,"");
  if(!nas){ say("Naslov je obvezen."); return; }
  var it={naslov:nas,kat:$("f-kat").value,povz:$("f-povz").value,bes:$("f-bes").value,avt:$("f-avt").value||"Filip Knez",kdaj:fmtKdaj(new Date())};
  if(cur<0){ data.unshift(it); cur=0; } else { data[cur]=it; }
  saveLocal(); renderList($("f-iskaj").value); updateCounts();
}
function delItem(){
  if(cur<0){ say("Najprej izberi novico v Navigaciji."); return; }
  var ok=true; try{ ok=confirm("Izbrišem novico '"+data[cur].naslov+"'?"); }catch(e){}
  if(!ok) return;
  data.splice(cur,1); cur=-1; clearForm(); saveLocal(); renderList($("f-iskaj").value);
}
function dupItem(){
  if(cur<0){ say("Najprej izberi novico."); return; }
  var c={}; for(var k in data[cur]) c[k]=data[cur][k];
  c.naslov=c.naslov+" (kopija)"; c.kdaj=fmtKdaj(new Date());
  data.splice(cur+1,0,c); cur=cur+1;
  saveLocal(); renderList($("f-iskaj").value); say("Novica podvojena.");
}
function moveIt(d){ if(cur<0){ say("Izberi novico."); return; }
  var j=cur+d; if(j<0||j>=data.length) return;
  var t=data[cur]; data[cur]=data[j]; data[j]=t; cur=j;
  saveLocal(); renderList($("f-iskaj").value); }
function saveToken(){ var t=$("f-token").value.replace(/^\s+|\s+$/g,""); if(!t){ say("Žeton je prazen."); return; }
  writeText(TOKF,t); say("Žeton shranjen v token.txt."); }
function readToken(){ if(!FSO.FileExists(TOKF)) return ""; return readText(TOKF).replace(/^\s+|\s+$/g,""); }
function publish(){
  rebuild(); writeText(IDX,html);
  var tok=readToken();
  if(!tok){ showTab("nast"); say("Manjka GitHub žeton: nastavi ga na zavihku Nastavitve in poskusi znova."); return; }
  say("Objavljam ...");
  var x=new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
  x.open("GET",API,false);
  x.setRequestHeader("Authorization","token "+tok);
  x.setRequestHeader("User-Agent","digitalnik-urejevalnik");
  x.setRequestHeader("Accept","application/vnd.github+json");
  x.send();
  if(x.status!=200){ say("GitHub ni odgovoril pri branju (koda "+x.status+"). Preveri žeton."); return; }
  var sha=""; try{ sha=JSON.parse(x.responseText).sha; }catch(e){}
  var b64=utf8B64(html);
  x=new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
  x.open("PUT",API,false);
  x.setRequestHeader("Authorization","token "+tok);
  x.setRequestHeader("User-Agent","digitalnik-urejevalnik");
  x.setRequestHeader("Accept","application/vnd.github+json");
  x.setRequestHeader("Content-Type","application/json");
  x.send('{"message":"Novice iz urejevalnika","content":"'+b64+'","sha":"'+sha+'"}');
  if(x.status==200||x.status==201) say("Objavljeno! Stran se posodobi na digitalnik.vercel.app v približno minuti.");
  else say("GitHub ni sprejel objave (koda "+x.status+"): "+x.responseText.substring(0,160));
}
function updateCounts(){
  var bes=$("f-bes").value, nas=$("f-naslov").value;
  var t=bes.replace(/^\s+|\s+$/g,"");
  var words=(t==""?0:t.split(/\s+/).length);
  $("s-counts").innerHTML=words+" besed · "+Math.max(1,Math.round(words/200))+" min branja";
  $("f-meta").value="Avtor: "+($("f-avt").value||"Filip Knez")+" · "+minB(bes);
}
function saveDraft(){ try{ writeText(DRAFTF,JSON.stringify({naslov:$("f-naslov").value,kat:$("f-kat").value,povz:$("f-povz").value,bes:$("f-bes").value,avt:$("f-avt").value})); }catch(e){} }
function loadDraft(){ if(!FSO.FileExists(DRAFTF)) return;
  try{ var d=JSON.parse(readText(DRAFTF));
    if(d&&d.naslov){ $("f-naslov").value=d.naslov||""; $("f-kat").value=d.kat||"AI"; $("f-povz").value=d.povz||""; $("f-bes").value=d.bes||""; $("f-avt").value=d.avt||"Filip Knez"; updateCounts(); say("Naloženo: "+data.length+" novic. Osnutek obnovljen."); }
  }catch(e){} }
function showTab(v){
  if(v=="dom"){ $("rib-dom").style.display="block"; $("rib-nast").style.display="none"; $("tab-dom").className="on"; $("tab-nast").className=""; }
  else{ $("rib-dom").style.display="none"; $("rib-nast").style.display="block"; $("tab-nast").className="on"; $("tab-dom").className=""; $("f-token").value=readToken(); }
}
window.resizeTo(1260,860);
$("btn-prenesi").onclick=downloadSite;
$("btn-objavi").onclick=publish;
$("btn-nova").onclick=function(){cur=-1;clearForm();renderList($("f-iskaj").value);say("Nova novica: piši na beli stran in Shrani.");};
$("btn-nova-sm").onclick=function(){cur=-1;clearForm();renderList($("f-iskaj").value);say("Nova novica: piši na beli stran in Shrani.");};
$("btn-shrani").onclick=saveItem;
$("btn-brisi").onclick=delItem;
$("btn-dup").onclick=dupItem;
$("btn-gor").onclick=function(){moveIt(-1);};
$("btn-dol").onclick=function(){moveIt(1);};
$("btn-token").onclick=saveToken;
$("f-iskaj").oninput=function(){renderList($("f-iskaj").value);};
$("f-naslov").oninput=function(){updateCounts();saveDraft();};
$("f-povz").oninput=function(){updateCounts();saveDraft();};
$("f-bes").oninput=function(){updateCounts();saveDraft();};
$("f-avt").oninput=saveDraft;
document.onkeydown=function(){ try{ if(event.ctrlKey&&event.keyCode==83){ event.returnValue=false; saveItem(); } }catch(e){} };
loadLocal();
updateCounts();
</script>
</body>
</html>
